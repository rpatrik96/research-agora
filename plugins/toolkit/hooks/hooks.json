{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Skill|Task|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/agora_feedback.py\" capture 2>/dev/null || true"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/agora_feedback.py\" capture 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
